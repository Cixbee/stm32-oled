{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32",
      "type": "process",
      "command": "C:\\Users\\Mechrevo\\AppData\\Local\\stm32cube\\bundles\\cmake\\4.4.0+st.1\\bin\\cmake.exe",
      "args": [
        "--build",
        "${workspaceFolder}/build/Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Flash STM32",
      "type": "process",
      "command": "C:\\Users\\Mechrevo\\AppData\\Local\\stm32cube\\bundles\\programmer\\2.23.0\\bin\\STM32_Programmer_CLI.exe",
      "args": [
        "-c",
        "port=SWD",
        "-d",
        "${workspaceFolder}/build/Debug/oled.elf",
        "-v",
        "-rst"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build STM32",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
